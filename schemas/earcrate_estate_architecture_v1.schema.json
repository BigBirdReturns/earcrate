{
  "$id": "https://earcrate.local/schema/earcrate_estate_architecture_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architecture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "directories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authority": {
            "type": "string"
          },
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
            "type": "string"
          },
          "retention": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "authority",
          "retention"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "invariants": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "kind": {
      "const": "earcrate_estate_architecture"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "name",
    "directories",
    "invariants",
    "architecture_sha256"
  ],
  "type": "object"
}
