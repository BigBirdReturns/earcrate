{
  "$id": "https://earcrate.local/schema/earcrate_floor_signal_evaluation_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "builder_identity_id": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evaluator": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string"
        },
        "identity_id": {
          "minLength": 1,
          "type": "string"
        },
        "identity_type": {
          "minLength": 1,
          "type": "string"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "identity_type",
        "version",
        "manifest_sha256",
        "display_name",
        "metadata"
      ],
      "type": "object"
    },
    "gates": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "kind": {
      "const": "earcrate_floor_signal_evaluation"
    },
    "metadata": {
      "type": "object"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "minProperties": 1,
      "type": "object"
    },
    "notes": {
      "type": "array"
    },
    "passed": {
      "type": "boolean"
    },
    "recurrence_identity": {
      "enum": [
        "not_evaluated",
        "passed",
        "failed"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "signal_evaluation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "transition_integrity": {
      "enum": [
        "not_evaluated",
        "provisional_pass",
        "passed",
        "failed"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "candidate_sha256",
    "builder_identity_id",
    "evaluator",
    "metrics",
    "gates",
    "passed",
    "status",
    "recurrence_identity",
    "transition_integrity",
    "notes",
    "metadata",
    "signal_evaluation_sha256"
  ],
  "title": "EarCrate Floor independent signal evaluation v1",
  "type": "object"
}
