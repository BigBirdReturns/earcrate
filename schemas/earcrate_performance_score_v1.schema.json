{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earcrate.local/schemas/earcrate_performance_score_v1.schema.json",
  "title": "EarCrate PerformanceScore v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "kind",
    "score_id",
    "timeline",
    "sources",
    "tracks",
    "master",
    "invariants",
    "authority",
    "command_history",
    "score_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "earcrate_performance_score"},
    "score_id": {"type": "string", "minLength": 1},
    "score_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timeline": {
      "type": "object",
      "required": ["sample_rate", "channels", "duration_samples", "shared_events"],
      "properties": {
        "sample_rate": {"type": "integer", "minimum": 8000},
        "channels": {"type": "integer", "enum": [1, 2]},
        "duration_samples": {"type": "integer", "minimum": 1},
        "shared_events": {"type": "array"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "role", "container_sha256"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "container_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "canonical_pcm_sha256": {
            "oneOf": [
              {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["track_id", "role", "ownership", "clips"],
        "properties": {
          "track_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "ownership": {"type": "string", "minLength": 1},
          "gain_db": {"type": "number", "minimum": -120, "maximum": 24},
          "pan": {"type": "number", "minimum": -1, "maximum": 1},
          "clips": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "clip_id",
                "source_id",
                "source_start_sample",
                "source_end_sample",
                "target_start_sample",
                "tempo_scale",
                "pitch_semitones",
                "gain_db",
                "pan",
                "fade_in_samples",
                "fade_out_samples",
                "musical_function",
                "occurrence_id",
                "locked"
              ],
              "properties": {
                "clip_id": {"type": "string", "minLength": 1},
                "source_id": {"type": "string", "minLength": 1},
                "source_start_sample": {"type": "integer", "minimum": 0},
                "source_end_sample": {"type": "integer", "minimum": 1},
                "target_start_sample": {"type": "integer", "minimum": 0},
                "tempo_scale": {"type": "number", "minimum": 0.25, "maximum": 4},
                "pitch_semitones": {"type": "number", "minimum": -24, "maximum": 24},
                "gain_db": {"type": "number", "minimum": -120, "maximum": 24},
                "pan": {"type": "number", "minimum": -1, "maximum": 1},
                "fade_in_samples": {"type": "integer", "minimum": 0},
                "fade_out_samples": {"type": "integer", "minimum": 0},
                "musical_function": {"type": "string", "minLength": 1},
                "occurrence_id": {"type": "string", "minLength": 1},
                "locked": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "master": {
      "type": "object",
      "required": ["gain_db", "codec"],
      "properties": {
        "gain_db": {"type": "number", "minimum": -120, "maximum": 24},
        "peak_limit_dbfs": {
          "oneOf": [
            {"type": "number", "minimum": -24, "maximum": 0},
            {"type": "null"}
          ]
        },
        "codec": {"enum": ["pcm_s16le", "pcm_s24le", "pcm_s32le", "flac"]}
      }
    },
    "command_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "command_id", "actor", "operation", "target", "parameters_sha256"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "command_id": {"type": "string", "minLength": 1},
          "parameters_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
