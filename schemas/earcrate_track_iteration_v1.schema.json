{
  "$id": "https://earcrate.local/schemas/earcrate_track_iteration_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "album_id": {
      "minLength": 1,
      "type": "string"
    },
    "children": {
      "items": {
        "required": [
          "candidate_id",
          "strategy",
          "musical_gap",
          "allowed_changes",
          "prohibited_changes",
          "duration_seconds",
          "mutation_budget",
          "control_question"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "estate_execution_order": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "estate_return_contract": {
      "required": [
        "required_fields",
        "private_material_must_remain_local",
        "public_projection_must_be_source_free"
      ],
      "type": "object"
    },
    "iteration_id": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "earcrate_track_iteration_contract"
    },
    "locked_invariants": {
      "items": {
        "required": [
          "id",
          "rule"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "machine_admission": {
      "required": [
        "required_for_every_child",
        "strategy_specific",
        "minimum_qualified_children",
        "owner_audition_prohibited_when_below_minimum"
      ],
      "type": "object"
    },
    "owner_frontier": {
      "required": [
        "incumbent",
        "challenger_limit",
        "roles_withheld",
        "duration_policy",
        "level_policy",
        "choices",
        "acceptance_semantics"
      ],
      "type": "object"
    },
    "parent": {
      "additionalProperties": true,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "type": "string"
        },
        "controls": {
          "type": "object"
        },
        "human_acceptance": {
          "type": "boolean"
        },
        "owner_review_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "owner_verdict": {
          "minLength": 1,
          "type": "string"
        },
        "protected_incumbent": {
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "owner_review_receipt_sha256",
        "owner_verdict",
        "human_acceptance",
        "protected_incumbent",
        "controls"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "terminal_logic": {
      "type": "object"
    },
    "track_id": {
      "pattern": "^A1-[0-9]{2}$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "album_id",
    "track_id",
    "iteration_id",
    "parent",
    "locked_invariants",
    "children",
    "machine_admission",
    "owner_frontier",
    "estate_execution_order",
    "estate_return_contract",
    "terminal_logic",
    "contract_sha256"
  ],
  "title": "EarCrate track iteration contract",
  "type": "object"
}
