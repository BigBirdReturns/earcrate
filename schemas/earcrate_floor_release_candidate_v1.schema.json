{
  "$id": "https://earcrate.local/schema/earcrate_floor_release_candidate_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audio_edit_plan": {
      "type": "object"
    },
    "authoritative_output": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "type": "string"
        },
        "channels": {
          "minimum": 0,
          "type": "integer"
        },
        "decoded_pcm_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "frames": {
          "minimum": 0,
          "type": "integer"
        },
        "media_kind": {
          "minLength": 1,
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sample_rate": {
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "decoded_pcm_sha256",
        "media_kind",
        "size_bytes",
        "sample_rate",
        "channels",
        "frames",
        "role",
        "path",
        "uri",
        "metadata"
      ],
      "type": "object"
    },
    "builder": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "type": "string"
        },
        "identity_id": {
          "minLength": 1,
          "type": "string"
        },
        "identity_type": {
          "minLength": 1,
          "type": "string"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "type": "object"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "identity_id",
        "identity_type",
        "version",
        "manifest_sha256",
        "display_name",
        "metadata"
      ],
      "type": "object"
    },
    "builder_may_not_approve_music": {
      "const": true
    },
    "candidate_id": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "delivery_artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "minLength": 1,
            "type": "string"
          },
          "channels": {
            "minimum": 0,
            "type": "integer"
          },
          "decoded_pcm_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "frames": {
            "minimum": 0,
            "type": "integer"
          },
          "media_kind": {
            "minLength": 1,
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "sample_rate": {
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "uri": {
            "type": "string"
          }
        },
        "required": [
          "artifact_id",
          "sha256",
          "decoded_pcm_sha256",
          "media_kind",
          "size_bytes",
          "sample_rate",
          "channels",
          "frames",
          "role",
          "path",
          "uri",
          "metadata"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence_branch": {
      "enum": [
        "audio",
        "performance",
        "review"
      ]
    },
    "evidence_tier": {
      "enum": [
        "blind_audio_inference",
        "performance_realization",
        "human_review"
      ]
    },
    "kind": {
      "const": "earcrate_floor_release_candidate"
    },
    "metadata": {
      "type": "object"
    },
    "phrase_contracts": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "source_evidence_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "build_reproducibility": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "custody": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "musical_acceptance": {
          "enum": [
            "pending",
            "accept",
            "revise",
            "reject"
          ]
        },
        "recurrence_identity": {
          "enum": [
            "not_evaluated",
            "passed",
            "failed"
          ]
        },
        "release_status": {
          "enum": [
            "blocked",
            "approved",
            "rejected"
          ]
        },
        "rights_eligibility": {
          "enum": [
            "not_evaluated",
            "accepted_by_policy",
            "blocked",
            "expired"
          ]
        },
        "signal_sanity": {
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        },
        "summary": {
          "enum": [
            "candidate_unqualified",
            "signal_failed",
            "signal_sane_human_review_pending",
            "human_revision_requested",
            "human_rejected",
            "rights_review_pending",
            "rights_blocked",
            "release_approved"
          ]
        },
        "transition_integrity": {
          "enum": [
            "not_evaluated",
            "provisional_pass",
            "passed",
            "failed"
          ]
        },
        "whole_organism_status": {
          "const": "not_claimed"
        }
      },
      "required": [
        "custody",
        "build_reproducibility",
        "signal_sanity",
        "recurrence_identity",
        "transition_integrity",
        "musical_acceptance",
        "rights_eligibility",
        "whole_organism_status",
        "release_status",
        "summary"
      ],
      "type": "object"
    },
    "time_map": {
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "candidate_id",
    "title",
    "builder",
    "evidence_branch",
    "evidence_tier",
    "source_evidence_refs",
    "audio_edit_plan",
    "time_map",
    "phrase_contracts",
    "authoritative_output",
    "delivery_artifacts",
    "status",
    "builder_may_not_approve_music",
    "metadata",
    "candidate_sha256"
  ],
  "title": "EarCrate Floor reviewed audio release candidate v1",
  "type": "object"
}
