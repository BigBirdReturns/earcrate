{
  "provider_id": "portable-music-server",
  "repository_revision": "<exact-portable-music-server-git-commit>",
  "adapter": {
    "kind": "http_json",
    "base_url": "http://127.0.0.1:9150",
    "health_endpoint": "/health",
    "models_endpoint": "/api/models",
    "require_model_installed": true,
    "model_id": "ace_step_v15",
    "probe_timeout_seconds": 10
  },
  "model_assets": [
    {
      "name": "<exact-installed-model-or-codec-file>",
      "path": "<private-local-path>",
      "sha256": "<64-hex-sha256>",
      "bytes": 1
    }
  ]
}
