{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earcrate.local/schema/earcrate_mix_score_v1.schema.json",
  "title": "EarCrate MixScore v1",
  "type": "object",
  "required": ["schema_version", "kind", "clock", "end_beat", "assets", "decks", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "earcrate_mix_score"},
    "title": {"type": "string"},
    "clock": {
      "type": "object",
      "required": ["bpm", "beats_per_bar", "sample_rate"],
      "properties": {
        "bpm": {"type": "number", "minimum": 20, "maximum": 300},
        "beats_per_bar": {"type": "integer", "minimum": 1, "maximum": 32},
        "sample_rate": {"type": "integer", "minimum": 8000, "maximum": 192000}
      },
      "additionalProperties": false
    },
    "end_beat": {"type": "number", "exclusiveMinimum": 0},
    "peak_ceiling": {"type": "number", "minimum": 0.01, "maximum": 1},
    "master_gain_db": {"type": "number", "minimum": -120, "maximum": 24},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "path", "source_bpm"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "source_bpm": {"type": "number", "minimum": 20, "maximum": 400},
          "downbeat_seconds": {"type": "number", "minimum": 0},
          "cues": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          },
          "expected_file_sha256": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "metadata": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["deck_id"],
        "properties": {
          "deck_id": {"type": "string", "minLength": 1},
          "crossfader_side": {"enum": ["A", "B", "NONE", "none"]},
          "gain_db": {"type": "number", "minimum": -120, "maximum": 24},
          "pan": {"type": "number", "minimum": -1, "maximum": 1},
          "metadata": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "event_id": {"type": "string", "minLength": 1},
          "op": {
            "enum": [
              "load", "play", "stop", "cut", "jump", "seek", "loop", "exit_loop",
              "set_rate", "nudge", "set_gain", "fade", "mute", "unmute", "set_pan",
              "set_crossfader", "crossfade"
            ]
          },
          "deck_id": {"type": "string", "minLength": 1},
          "asset_id": {"type": "string", "minLength": 1},
          "at_beat": {"type": "number", "minimum": 0},
          "from_beat": {"type": "number", "minimum": 0},
          "to_beat": {"type": "number", "minimum": 0},
          "cue": {"type": "string", "minLength": 1},
          "source_beat": {"type": "number", "minimum": 0},
          "sync": {"type": "boolean"},
          "rate": {"type": "number", "exclusiveMinimum": 0.05, "maximum": 8},
          "length_beats": {"type": "number", "minimum": 0.015625, "maximum": 256},
          "crossfade_ms": {"type": "number", "minimum": 0, "maximum": 100},
          "delta_source_beats": {"type": "number"},
          "delta_ms": {"type": "number"},
          "gain_db": {"type": "number", "minimum": -120, "maximum": 24},
          "from_db": {"type": "number", "minimum": -120, "maximum": 24},
          "to_db": {"type": "number", "minimum": -120, "maximum": 24},
          "curve": {"enum": ["linear", "linear_db", "equal_power", "s_curve"]},
          "pan": {"type": "number", "minimum": -1, "maximum": 1},
          "position": {"type": "number", "minimum": -1, "maximum": 1},
          "from_position": {"type": "number", "minimum": -1, "maximum": 1},
          "to_position": {"type": "number", "minimum": -1, "maximum": 1}
        },
        "oneOf": [
          {"required": ["at_beat"], "not": {"anyOf": [{"required": ["from_beat"]}, {"required": ["to_beat"]}]}},
          {"required": ["from_beat", "to_beat"], "not": {"required": ["at_beat"]}}
        ],
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object", "additionalProperties": true},
    "score_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
