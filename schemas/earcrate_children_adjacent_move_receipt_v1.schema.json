{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earcrate.local/schema/earcrate_children_adjacent_move_receipt_v1.schema.json",
  "title": "EarCrate Children proof-carrying adjacent-move receipt v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "specimen_id",
    "answer_key_sha256",
    "legal",
    "negative_control_refused",
    "program_sha256",
    "composition_sha256",
    "committed_event_count",
    "open_obligation_count",
    "novelty",
    "midi",
    "boundary",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "earcrate_children_adjacent_move_receipt"},
    "specimen_id": {"const": "children_v1"},
    "answer_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_score_ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_midi_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "continuation_start_step": {"type": "integer", "minimum": 0},
    "continuation_end_step": {"type": "integer", "minimum": 1},
    "duration_bars": {"type": "integer", "minimum": 1, "maximum": 32},
    "legal": {"const": true},
    "negative_control_refused": {"const": true},
    "program_id": {"type": "string", "minLength": 1},
    "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "composition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "committed_event_count": {"type": "integer", "minimum": 1},
    "open_obligation_count": {"const": 0},
    "source_evidence": {"type": "object"},
    "harmony_frames": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "composition": {"type": "object"},
    "negative_control": {
      "type": "object",
      "required": ["event", "proof", "commit_refused"],
      "properties": {
        "event": {"type": "object"},
        "proof": {"type": "object"},
        "commit_refused": {"const": true}
      },
      "additionalProperties": true
    },
    "novelty": {
      "type": "object",
      "required": ["literal_copy_detected", "continuation_signature_sha256"],
      "properties": {
        "literal_copy_detected": {"const": false},
        "continuation_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "midi": {
      "type": "object",
      "required": [
        "semantic_sha256",
        "selected_event_count",
        "executed_event_count",
        "refused_event_count",
        "program_sha256",
        "execution_sha256",
        "neutral_pcm_f32le_sha256"
      ],
      "properties": {
        "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_event_count": {"type": "integer", "minimum": 1},
        "executed_event_count": {"type": "integer", "minimum": 1},
        "refused_event_count": {"const": 0},
        "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "neutral_pcm_f32le_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stem_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "boundary": {
      "type": "object",
      "required": [
        "commercial_recording_consulted",
        "private_library_consulted",
        "accepted_prefix_rewritten",
        "source_media_bundled"
      ],
      "properties": {
        "commercial_recording_consulted": {"const": false},
        "private_library_consulted": {"const": false},
        "accepted_prefix_rewritten": {"const": false},
        "source_media_bundled": {"const": false}
      },
      "additionalProperties": false
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
